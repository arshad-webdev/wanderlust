<% layout('/layouts/boilerplate.ejs') -%>
<body>
    <h3>All Listings</h3>
    <form action="/listings/new">
        <button>Add listing </button>
    </form>
    <ul>
        <% for(let list of allListings) { %>
            <li><a href="/listings/<%= list.id %>"><%= list.title %></a></li>
        <% } %>
        </ul>
</body>
