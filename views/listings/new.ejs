<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wanderlust</title>
  </head>
  <body>
    <form action="/listings/new" method="post">
      <input type="text" placeholder="title" name="listing[title]" />
      <br />
      <br />
      <input
        type="text"
        placeholder="description"
        name="listing[description]"
      />
      <br />
      <br />
      <input type="number" placeholder="price" name="listing[price]" />
      <br />
      <br />
      <input type="text" placeholder="location" name="listing[location]" />
      <br />
      <br />
      <input type="text" placeholder="country" name="listing[country]" />
      <br />
      <br />
      <button>Add</button>
    </form>
  </body>
</html>
